{
  "name": "@tulip/mcp-server",
  "version": "1.3.1",
  "description": "Model Context Protocol server for Tulip API",
  "main": "src/index.js",
  "type": "module",
  "files": [
    "src",
    "skills",
    ".claude-plugin",
    "env.example",
    "CHANGELOG.md"
  ],
  "bin": {
    "tulip-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "mcp": "node src/index.js",
    "dev": "node --watch src/index.js",
    "docs": "node generateToolsDoc.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.5.0",
    "minimist": "^1.2.8",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tulip",
    "api"
  ],
  "author": "Brennan Reamer & Mark Watabe",
  "license": "Apache-2.0"
}
