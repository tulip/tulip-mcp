{
  "name": "reportAttributes",
  "description": "Reports machine attribute values. Corresponds to POST /attributes/report. Requires `attributes:report` scope. [WRITE]",
  "inputSchema": {
    "type": "object",
    "properties": {
      "attributes": {
        "type": "array",
        "description": "Attribute values to report.",
        "items": {
          "type": "object",
          "properties": {
            "machineId": {
              "type": "string",
              "description": "Machine ID.",
              "minLength": 1
            },
            "attributeId": {
              "type": "string",
              "description": "Attribute ID.",
              "minLength": 1
            },
            "value": {
              "description": "Value to report: a string, number or boolean matching the attribute type."
            }
          },
          "required": ["machineId", "attributeId", "value"]
        }
      }
    },
    "required": ["attributes"]
  },
  "category": "write",
  "type": "machine",
  "dangerous": false,
  "httpType": "POST",
  "url": "/attributes/report"
}
