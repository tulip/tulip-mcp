{
  "name": "updateTableQuery",
  "description": "Updates a query in a Tulip Table by the query id. Corresponds to PUT /tables/{tableId}/query/{queryId}. Requires `table-queries:write` scope. [WRITE]",
  "inputSchema": {
    "type": "object",
    "properties": {
      "queryId": {
        "type": "string",
        "description": "The ID of the query to update.",
        "minLength": 1
      },
      "tableId": {
        "type": "string",
        "description": "The ID of the Tulip Table that the query is being created on.",
        "minLength": 1
      },
      "label": {
        "type": "string",
        "description": "Display label (1-40 characters).",
        "minLength": 1,
        "maxLength": 40
      },
      "filters": {
        "type": "array",
        "description": "Filter conditions. Note saved queries use value:{datasourceType,params:{value}}, not the `arg` used by listTableRecords.",
        "items": {
          "type": "object",
          "properties": {
            "_id": {
              "type": "string",
              "description": "Filter ID; generated if omitted."
            },
            "field": {
              "type": "string",
              "description": "Column name (getTable .columns[].name) or _createdAt/_updatedAt."
            },
            "functionType": {
              "type": "string",
              "description": "Comparison function.",
              "enum": ["equal", "notEqual", "blank", "notBlank", "greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual", "contains", "notContains", "startsWith", "notStartsWith", "endsWith", "notEndsWith", "isIn", "notIsIn"]
            },
            "value": {
              "type": "object",
              "description": "Value to compare to; omit for blank/notBlank. {\"datasourceType\":\"static\",\"params\":{\"value\":<value of the column's type>}}.",
              "properties": {
                "datasourceType": {
                  "type": "string",
                  "description": "\"static\" for a fixed value.",
                  "enum": ["static"]
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "description": "The value, as the column's type (string, number or boolean)."
                    }
                  },
                  "required": ["value"]
                }
              },
              "required": ["datasourceType", "params"]
            }
          },
          "required": ["field", "functionType"]
        }
      },
      "filterAggregator": {
        "type": "string",
        "description": "How to combine filters (default \"all\").",
        "enum": ["all", "any"]
      },
      "sortOptions": {
        "type": "array",
        "description": "Sort order, in priority order.",
        "items": {
          "type": "object",
          "properties": {
            "sortBy": {
              "type": "string",
              "description": "Column name or _createdAt/_updatedAt."
            },
            "sortDir": {
              "type": "string",
              "description": "Sort direction.",
              "enum": ["asc", "desc"]
            }
          },
          "required": ["sortBy", "sortDir"]
        }
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of records the query returns (1-1000).",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "required": ["tableId", "queryId", "label", "limit"]
  },
  "category": "write",
  "type": "table",
  "dangerous": false,
  "httpType": "PUT",
  "url": "/tables/:tableId/query/:queryId"
}
