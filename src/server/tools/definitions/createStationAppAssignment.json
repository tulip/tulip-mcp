{
  "name": "createStationAppAssignment",
  "description": "Creates an app assignment for a station. Corresponds to POST /api/stations/v1/stations/{stationId}/app-assignments. Requires `stations:write` scope. [WRITE]",
  "inputSchema": {
    "type": "object",
    "properties": {
      "stationId": {
        "type": "string",
        "description": "The ID of the station",
        "minLength": 1
      },
      "appAssignmentData": {
        "type": "object",
        "description": "App assignment. all/app-folder/app need `tag`; app-folder needs appFolderId; app needs appId; app-version needs appVersionId.",
        "properties": {
          "type": {
            "type": "string",
            "description": "\"all\" apps, an \"app-folder\", one \"app\", or one \"app-version\".",
            "enum": ["all", "app-folder", "app", "app-version"]
          },
          "tag": {
            "type": "string",
            "description": "Which app version runs: the development version or the latest published one.",
            "enum": ["development", "latest-published"]
          },
          "appFolderId": {
            "type": "string",
            "description": "App folder ID (type app-folder)."
          },
          "appId": {
            "type": "string",
            "description": "App ID (type app)."
          },
          "appVersionId": {
            "type": "string",
            "description": "App version ID (type app-version)."
          }
        },
        "required": ["type"]
      }
    },
    "required": ["stationId", "appAssignmentData"]
  },
  "category": "write",
  "type": "station",
  "dangerous": false,
  "httpType": "POST",
  "url": "/api/stations/v1/stations/:stationId/app-assignments"
}
