  "inputSchema": {
    "type": "object",
    "properties": {
      "userGroupId": {
        "type": "string",
        "description": "The ID of the user group",
        "minLength": 1
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of items (0-200).",
        "minimum": 0,
        "maximum": 200
      },
      "offset": {
        "type": "integer",
        "description": "Number of items to skip.",
        "minimum": 0
      },
      "filter": {
        "type": "string",
        "description": "OData-style filter, e.g. userId eq '<id>'."
      }
    },
    "required": ["userGroupId"]
  },
  "category": "read-only",
  "type": "user",
  "dangerous": false,
  "httpType": "GET",
  "url": "/api/users/v1/user-groups/:userGroupId/users"
}
